{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ATELIER_FOUNDER_VISUAL_PREFERENCE_DATASET_V1",
  "title": "Atelier Founder Visual Preference Dataset V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "datasetRevision", "authority", "productionBinding", "sourceManifest", "persistence", "session", "decisions"],
  "properties": {
    "schema": { "const": "ATELIER_FOUNDER_VISUAL_PREFERENCE_DATASET_V1" },
    "version": { "const": 1 },
    "datasetRevision": { "type": "integer", "minimum": 1 },
    "authority": { "const": "FOUNDER_EXPLICIT_DECISIONS_ONLY" },
    "productionBinding": { "const": false },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "itemCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "itemCount": { "const": 331 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "browserLocalStorageIsAuthoritative", "appendOnlyDecisionHistory"],
      "properties": {
        "mode": { "const": "WORKTREE_FILE" },
        "browserLocalStorageIsAuthoritative": { "const": false },
        "appendOnlyDecisionHistory": { "const": true }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastCvaId", "updatedAt"],
      "properties": {
        "lastCvaId": { "type": ["string", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "provenance", "exactMapping", "originalTraitDimensions"],
      "properties": {
        "kind": { "enum": ["FOUNDER_REVIEW", "EXACT_IMPORT", "SUPERSESSION"] },
        "identifier": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "exactMapping": { "const": true },
        "originalTraitDimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/traitDimension" } }
      }
    },
    "traitDimension": { "enum": ["colour", "surface", "composition", "geometry", "typography", "spacing/density", "image treatment", "wave", "luminosity", "dark/light balance", "human warmth", "interaction", "motion", "mobile composition"] },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "signal"],
      "properties": {
        "dimension": { "$ref": "#/$defs/traitDimension" },
        "signal": { "enum": ["POSITIVE", "NEGATIVE", "MIXED", "UNRESOLVED"] },
        "note": { "type": "string" }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepConcept", "needsRefinement", "needsUpgrade", "wrongColours", "wrongTypography", "wrongImagery", "wrongGeometry", "wrongComposition", "wrongInteraction"],
      "properties": {
        "keepConcept": { "type": "boolean" }, "needsRefinement": { "type": "boolean" }, "needsUpgrade": { "type": "boolean" },
        "wrongColours": { "type": "boolean" }, "wrongTypography": { "type": "boolean" }, "wrongImagery": { "type": "boolean" },
        "wrongGeometry": { "type": "boolean" }, "wrongComposition": { "type": "boolean" }, "wrongInteraction": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "cvaId", "status", "wholeItemSignal", "notes", "traits", "flags", "source", "timestamp", "version", "supersedes"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "cvaId": { "type": "string", "pattern": "^CVA-" },
        "status": { "enum": ["CURRENT", "SUPERSEDED"] },
        "wholeItemSignal": { "enum": ["LOVE", "LIKE", "MAYBE", "NOT_ME", "UNRATED"] },
        "notes": { "type": "string" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/trait" } },
        "flags": { "$ref": "#/$defs/flags" },
        "source": { "$ref": "#/$defs/source" },
        "timestamp": { "type": "string", "format": "date-time" },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": ["string", "null"] }
      }
    }
  }
}
