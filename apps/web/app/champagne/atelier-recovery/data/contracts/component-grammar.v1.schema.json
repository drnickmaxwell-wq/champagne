{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ATELIER_COMPONENT_GRAMMAR_V1",
  "title": "Atelier Adaptive Component Grammar V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "componentId", "version", "lineage", "preferenceState", "brandDependencies", "semanticRoles", "contentSlots", "surfaces", "composition", "colourRoles", "typographyRoles", "spacing", "media", "interaction", "motion", "responsive", "accessibility", "contentShapes", "incompatibilities", "antiDnaConstraints", "provenance", "maturity", "productionBinding"],
  "properties": {
    "schema": { "const": "ATELIER_COMPONENT_GRAMMAR_V1" },
    "componentId": { "type": "string", "pattern": "^ATC-" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCvaIds", "decisionIds"],
      "properties": {
        "sourceCvaIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CVA-" } },
        "decisionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "preferenceState": { "enum": ["LOVE", "LIKE", "MAYBE", "NOT_ME", "UNRATED", "MIXED_LINEAGE"] },
    "brandDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "requiredEvidencePaths"],
      "properties": {
        "authority": { "const": "CHAMPAGNE_FOUNDER_BRAND_DNA_V1@1.0.0" },
        "requiredEvidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "semanticRoles": { "type": "array", "minItems": 1, "items": { "enum": ["orientation", "decision_support", "process", "evidence", "reassurance", "action", "navigation", "closing", "footer", "media_explanation"] } },
    "contentSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required", "editable"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["eyebrow", "heading", "body", "list", "cta", "media", "caption", "source", "interactive"] },
          "required": { "type": "boolean" },
          "editable": { "type": "boolean" },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "surfaces": { "type": "array", "minItems": 1, "items": { "enum": ["PORCELAIN", "PERSIAN", "LUMINOUS_TRANSITION", "FOOTER_EMOTION"] } },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proportions", "relationships", "layering", "overlap", "geometry", "waveBehaviour"],
      "properties": {
        "proportions": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "array", "items": { "type": "string" } },
        "layering": { "type": "array", "items": { "type": "string" } },
        "overlap": { "type": "array", "items": { "type": "string" } },
        "geometry": { "type": "array", "items": { "type": "string" } },
        "waveBehaviour": { "type": "array", "items": { "type": "string" } }
      }
    },
    "colourRoles": { "type": "array", "items": { "enum": ["MAGENTA_HUMAN_ACTION", "TURQUOISE_EXPLANATION_CLARITY", "GOLD_PRECISION_HIERARCHY", "PERSIAN_DEPTH", "PORCELAIN_LIFT"] } },
    "typographyRoles": { "type": "array", "items": { "type": "string" } },
    "spacing": { "type": "object", "required": ["rhythm", "density"], "properties": { "rhythm": { "type": "array", "items": { "type": "string" } }, "density": { "enum": ["QUIET", "EDITORIAL", "INFORMATION_RICH", "COMPACT_MOBILE"] } }, "additionalProperties": false },
    "media": { "type": "object", "required": ["slots", "geometry", "threeDBoundary"], "properties": { "slots": { "type": "array", "items": { "type": "string" } }, "geometry": { "type": "array", "items": { "type": "string" } }, "threeDBoundary": { "enum": ["NONE", "STATIC_ONLY", "SEMANTIC_SLOT_ONLY"] } }, "additionalProperties": false },
    "interaction": { "type": "array", "items": { "type": "string" } },
    "motion": { "type": "object", "required": ["behaviours", "reducedMotion"], "properties": { "behaviours": { "type": "array", "items": { "type": "string" } }, "reducedMotion": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1440", "1024", "768", "390"],
      "properties": {
        "1440": { "$ref": "#/$defs/transformation" },
        "1024": { "$ref": "#/$defs/transformation" },
        "768": { "$ref": "#/$defs/transformation" },
        "390": { "$ref": "#/$defs/transformation" }
      }
    },
    "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "contentShapes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "incompatibilities": { "type": "array", "items": { "type": "string" } },
    "antiDnaConstraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": { "type": "object", "required": ["author", "createdAt", "evidence"], "properties": { "author": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "evidence": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "maturity": { "enum": ["EXPERIMENTAL", "FOUNDER_APPROVED", "GOLDEN"] },
    "productionBinding": { "const": false }
  },
  "$defs": {
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "content", "media", "interaction"],
      "properties": {
        "layout": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "array", "items": { "type": "string" } },
        "media": { "type": "array", "items": { "type": "string" } },
        "interaction": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
